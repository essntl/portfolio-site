---
import avatar from "/public/avatar.jpg"
import { Image } from "astro:assets";
---

<section class="relative flex flex-col items-center justify-center min-h-[90vh] text-center px-4">
  <!-- Background gradient -->
  <div class="absolute inset-0 -z-10 bg-black">

  </div>

  <!-- Avatar -->
  <Image
    src={avatar}
    alt="Artyom"
    width={512}
    height={512}
    class="w-48 h-48 rounded-2xl object-cover shadow-lg mb-6"
  />

  <!-- Hero text -->
  <h1 class="text-5xl font-bold text-white mb-3 tracking-tight">
    Hello, I'm Artyom
  </h1>


  <p class="text-gray-400 text-lg mb-8 max-w-md">
    I specialize in front-end development and user-focused tech solutions
  </p>

