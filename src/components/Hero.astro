---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.jpg";
---

<section class="flex flex-col items-center justify-center pt-24 md:pt-40 pb-12 md:pb-16 text-center px-6">
  <Image
    src={avatar}
    alt="Artyom"
    width={384}
    height={384}
    class="w-32 h-32 md:w-48 md:h-48 rounded-2xl object-cover shadow-lg mb-6"
    loading="eager"
  />

  <h1 class="text-4xl md:text-5xl font-bold text-white mb-3 tracking-tight">
    Hello, I'm Artyom
  </h1>

  <p class="text-zinc-400 text-base md:text-lg max-w-md">
    I specialize in front-end development and user-focused tech solutions
  </p>
</section>
