---
import { Image } from "astro:assets";
import { github } from "../data/github";

const avatar = {
  alt: "Artyom",
  width: 384,
  height: 384,
  class: "w-44 h-44 md:w-48 md:h-48 rounded-2xl object-cover shadow-lg mb-6",
  loading: "eager",
} as const;
---

<section class="flex flex-col items-center justify-center pt-24 md:pt-40 pb-12 md:pb-16 text-center px-6">
  {/* Remote URL from GitHub, or the bundled fallback if GitHub was unreachable */}
  {typeof github.avatar === "string"
    ? <Image src={github.avatar} {...avatar} />
    : <Image src={github.avatar} {...avatar} />}

  <h1 class="text-4xl md:text-5xl font-bold text-white mb-3 tracking-tight">
    Hello, I'm Artyom
  </h1>

  <p class="text-zinc-400 text-base md:text-lg max-w-md">
    Building solutions for everyday problems. Ukrainian developer based in Norway
  </p>
</section>
