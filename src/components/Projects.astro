---
import SectionLabel from './SectionLabel.astro';
import { Image } from 'astro:assets';
import { projects } from '../data/site';

const imageClass = "w-full h-full object-cover object-top block transition-transform duration-300 group-hover:scale-[1.03]";
---

<section id="projects" class="max-w-[68rem] mx-auto px-6 pb-20 md:pb-32">
  <SectionLabel>Projects</SectionLabel>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
    {projects.map(project => (
      <article class="group flex flex-col border border-zinc-800 rounded-xl overflow-hidden hover:-translate-y-0.75 hover:border-zinc-700 transition">
        <div class="aspect-8/5 overflow-hidden bg-zinc-900">
          {typeof project.image === "string" ? (
            <img src={project.image} alt={project.title} loading="lazy" class={imageClass} />
          ) : (
            <Image src={project.image} alt={project.title} width={800} class={imageClass} />
          )}
        </div>
        <div class="flex flex-col gap-3 p-5 md:p-6">
          <h3 class="text-[1.15rem] font-semibold">{project.title}</h3>
          <p class="text-zinc-400 leading-[1.6] text-[0.9rem]">{project.description}</p>
          <ul class="flex flex-wrap gap-2 list-none p-0 mt-1">
            {project.tags.map(tag => (
              <li class="text-[0.7rem] tracking-wider uppercase text-zinc-400 border border-zinc-800 rounded-full py-[0.2rem] px-[0.6rem]">{tag}</li>
            ))}
          </ul>
          <div class="flex gap-4 mt-2 text-[0.85rem]">
            {project.url && (
              <a class="text-zinc-200 no-underline hover:underline" href={project.url} target="_blank" rel="noopener noreferrer">View project →</a>
            )}
            <a class="text-zinc-400 no-underline hover:underline" href={project.repo} target="_blank" rel="noopener noreferrer">Source ↗</a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
