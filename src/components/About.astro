---
import SectionLabel from './SectionLabel.astro';
import { getIcon } from '../data/icons';
import { stack, stats } from '../data/site';

const stackIcons = stack.map(getIcon);
---

<section id="about" class="max-w-[68rem] mx-auto py-20 md:py-32 px-6">
  <SectionLabel>About</SectionLabel>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-start">
    <div>
      <h2 class="text-[clamp(1.75rem,3vw,2.25rem)] mb-5">A bit about me</h2>
      <div class="flex flex-col gap-4 text-zinc-400 leading-[1.7] max-w-xl">
        <p>
          Ever since I was a kid I've been curious about how things work. I got into
          tech early and it stuck with me. I love taking things apart, especially
          hardware, I run a bunch of stuff on my own server, and I have way more
          ideas than time.
        </p>
        <p>
          Most of what I build starts with something that annoys me, either because
          it's inefficient or because it's missing a feature that feels like a no
          brainer. So instead of waiting for someone else to fix it, I fix it myself
          and keep it as simple as I can.
        </p>
      </div>
    </div>

    <dl class="grid grid-cols-3 gap-4 md:grid-cols-1 md:gap-8 md:justify-items-end md:text-right">
      {stats.map(stat => (
        <div class="flex flex-col-reverse justify-end">
          <dt class="text-[0.8rem] text-zinc-400 mt-2">{stat.label}</dt>
          <dd class="text-[clamp(2rem,5vw,3.5rem)] font-bold leading-none">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="mt-16 md:mt-24">
    <SectionLabel>Stack</SectionLabel>
    <ul class="flex flex-wrap gap-x-6 gap-y-4 list-none p-0">
      {stackIcons.map(icon => (
        <li class="flex items-center gap-2 opacity-70 hover:opacity-100 hover:-translate-y-0.5 transition">
          <svg role="img" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-6 h-6">
            <path d={icon.path} />
          </svg>
          <span class="text-[0.85rem] text-zinc-400">{icon.title}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
