---
import SectionLabel from './SectionLabel.astro';
import { stack, stats } from '../data/site';
---

<section id="about" class="max-w-[68rem] mx-auto py-20 md:py-32 px-6">
  <SectionLabel>About</SectionLabel>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-start">
    <div>
      <h2 class="text-[clamp(1.75rem,3vw,2.25rem)] mb-5">A bit about me</h2>
      <p class="text-zinc-400 leading-[1.7] max-w-xl">
        Most of my projects start with a small, real-life annoyance — sharing trip
        photos without losing quality, or trying to learn from a Wikipedia page
        written for experts. I build the tool I wish existed and keep it as simple
        as possible, because simplicity is what people actually need.
      </p>
    </div>

    <dl class="grid grid-cols-3 gap-4 md:grid-cols-1 md:gap-8 md:justify-items-end md:text-right">
      {stats.map(stat => (
        <div class="flex flex-col-reverse justify-end">
          <dt class="text-[0.8rem] text-zinc-400 mt-2">{stat.label}</dt>
          <dd class="text-[clamp(2rem,5vw,3.5rem)] font-bold leading-none">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="mt-16 md:mt-24">
    <SectionLabel>Stack</SectionLabel>
    <ul class="flex flex-wrap gap-x-6 gap-y-4 list-none p-0">
      {stack.map(icon => (
        <li class="flex items-center gap-2 opacity-70 hover:opacity-100 hover:-translate-y-0.5 transition">
          <img src={`https://cdn.simpleicons.org/${icon}/white`} alt="" loading="lazy" class="w-6 h-6" />
          <span class="text-[0.85rem] text-zinc-400">{icon}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
