---
import { getImage } from 'astro:assets';
import { github } from '../data/github';
import '../styles/global.css';

// Favicons are made from the GitHub avatar at build time
const favicon = await getImage({ src: github.avatar, width: 32, height: 32, format: 'png' });
const appleIcon = await getImage({ src: github.avatar, width: 180, height: 180, format: 'png' });

const description = "Artyom — front-end developer focused on clean, fast, user-focused interfaces.";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" sizes="32x32" href={favicon.src} />
		<link rel="apple-touch-icon" href={appleIcon.src} />
		<meta name="generator" content={Astro.generator} />
		<title>ArtemK.dev</title>
	</head>
	<body class="bg-black text-white min-h-screen m-0">
		<header class="flex flex-row items-center justify-between gap-4 pt-6 px-6 max-w-[68rem] mx-auto">
			<a href="/" class="m-0 text-xl md:text-3xl">ArtemK.dev</a>
			<nav class="flex items-center gap-4 md:gap-5 text-sm md:text-base">
				<a href="#about" class="text-zinc-400 hover:text-white transition-colors">About</a>
				<a href="#projects" class="text-zinc-400 hover:text-white transition-colors">Projects</a>
				<a href="#infrastructure" class="text-zinc-400 hover:text-white transition-colors">Infra</a>
				<a href="#contact" class="text-zinc-400 hover:text-white transition-colors">Contact</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>
